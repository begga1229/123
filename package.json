{
  "name": "formula-studio",
  "productName": "Formula Studio",
  "version": "1.0.0",
  "description": "Offline Excel formula assistant: write what you need in Turkish or Russian, get the formula, explanation and apply it to your workbook.",
  "author": "Formula Studio",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "test": "node tests/run.js",
    "test:verbose": "node tests/run.js --verbose",
    "fixtures": "node tests/fixtures/make-samples.js",
    "smoke": "node tests/smoke.js",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1",
    "start": "electron .",
    "desktop": "electron .",
    "build:desktop": "node tools/build-desktop.js",
    "icons": "node tools/make-icons.js"
  }
}
